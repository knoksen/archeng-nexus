# Port for the Express server (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins
# Leave empty to deny cross-origin browser access
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://anotherdomain.com
ALLOWED_ORIGINS=

# Set to 1 only when running behind exactly one trusted reverse proxy
TRUST_PROXY=0

# Node environment (development, production, test)
NODE_ENV=development